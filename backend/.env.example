# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://mst7-3fb55-default-rtdb.firebaseio.com/

# m.Stock API Credentials (DO NOT COMMIT ACTUAL VALUES)
MSTOCK_APP_CODE=your_app_code_here
MSTOCK_USER_ID=your_user_id_here
MSTOCK_PASSWORD=your_password_here
MSTOCK_TOTP_SECRET=your_totp_secret_here

# m.Stock API Endpoints
MSTOCK_API_URL=https://api.mstock.com
MSTOCK_WS_URL=wss://ws.mstock.com

# Database Configuration
FIRESTORE_COLLECTION_USERS=users
FIRESTORE_COLLECTION_ORDERFLOW=orderflow

# Security
JWT_SECRET=your_jwt_secret_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Market Configuration
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
TIMEZONE=Asia/Kolkata

# Email Configuration (for admin notifications)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=jivaspcet@gmail.com

# Backend URL (for email approval links)
BACKEND_URL=http://localhost:3000
